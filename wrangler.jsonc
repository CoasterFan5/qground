{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qground",
  "main": "svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "r2_buckets": [
    {
      "bucket_name": "qground-projects",
      "remote": false,
      "binding": "projectStorage",
    }
  ]
}
